+pub(in crate::passes) fn byte_swap_i16(
+    ctx: &mut Ctx,
+    res: Word,
+    rty: Word,
+    value: Word,
+) -> Vec<Instruction> {
+    let mask_byte0 = ctx.const_int_of(rty, 0x00ff);
+    let mask_byte1 = ctx.const_int_of(rty, 0xff00);
+    let shift8 = ctx.const_int_of(rty, 8);
+    byte_swap_i16_with(ctx, res, rty, value, [mask_byte0, mask_byte1], shift8)
+}
+
+pub(in crate::passes) fn byte_swap_i16_vector(
+    ctx: &mut Ctx,
+    res: Word,
+    rty: Word,
+    elem: Word,
+    lanes: u32,
+    value: Word,
+) -> Vec<Instruction> {
+    let mut splat = |v: i64| {
+        let scalar = ctx.const_int_of(elem, v);
+        ctx.const_composite(rty, vec![scalar; lanes as usize])
+    };
+    let mask_byte0 = splat(0x00ff);
+    let mask_byte1 = splat(0xff00);
+    let shift8 = splat(8);
+    byte_swap_i16_with(ctx, res, rty, value, [mask_byte0, mask_byte1], shift8)
+}
+
+fn byte_swap_i16_with(
+    ctx: &mut Ctx,
+    res: Word,
+    rty: Word,
+    value: Word,
+    masks: [Word; 2],
+    shift8: Word,
+) -> Vec<Instruction> {
+    let [mask_byte0, mask_byte1] = masks;
+
+    let b0 = ctx.module.fresh_id();
+    let b1 = ctx.module.fresh_id();
+    let b0_hi = ctx.module.fresh_id();
+    let b1_lo = ctx.module.fresh_id();
+
+    vec![
+        Instruction::new(
+            Op::BitwiseAnd,
+            Some(rty),
+            Some(b0),
+            vec![Operand::IdRef(value), Operand::IdRef(mask_byte0)],
+        ),
+        Instruction::new(
+            Op::BitwiseAnd,
+            Some(rty),
+            Some(b1),
+            vec![Operand::IdRef(value), Operand::IdRef(mask_byte1)],
+        ),
+        Instruction::new(
+            Op::ShiftLeftLogical,
+            Some(rty),
+            Some(b0_hi),
+            vec![Operand::IdRef(b0), Operand::IdRef(shift8)],
+        ),
+        Instruction::new(
+            Op::ShiftRightLogical,
+            Some(rty),
+            Some(b1_lo),
+            vec![Operand::IdRef(b1), Operand::IdRef(shift8)],
+        ),
+        Instruction::new(
+            Op::BitwiseOr,
+            Some(rty),
+            Some(res),
+            vec![Operand::IdRef(b0_hi), Operand::IdRef(b1_lo)],
+        ),
+    ]
+}
