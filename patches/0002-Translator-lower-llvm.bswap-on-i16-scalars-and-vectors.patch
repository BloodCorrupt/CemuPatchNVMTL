+fn assert_native_bswap_vector_i16_lowers(lanes: u32) {
+    let ll = format!(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @main(<{lanes} x i16> %x) {{
+entry:
+  %swapped = tail call <{lanes} x i16> @llvm.bswap.v{lanes}i16(<{lanes} x i16> %x)
+  ret void
+}}
+
+declare <{lanes} x i16> @llvm.bswap.v{lanes}i16(<{lanes} x i16>)
+"#
+    );
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_native_bswap_v{lanes}_i16_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let module =
+        load_bytes(emit_vulkan_spirv(&ll).expect("native emit")).expect("load native spv");
+    let out = passes::transform(module, Stage::Kernel, None, None, None, Some("main"))
+        .expect("interface transform")
+        .assemble()
+        .iter()
+        .flat_map(|w| w.to_le_bytes())
+        .collect::<Vec<_>>();
+    let asm = disassemble(&out).expect("disassemble transformed");
+    assert!(asm.contains("OpShiftLeftLogical"), "{asm}");
+    assert!(asm.contains("OpShiftRightLogical"), "{asm}");
+    assert!(asm.contains("OpBitwiseAnd"), "{asm}");
+    assert!(asm.contains("OpBitwiseOr"), "{asm}");
+    assert!(asm.contains("OpConstantComposite"), "{asm}");
+    assert!(!asm.contains("OpFunctionCall"), "{asm}");
+}
+
+#[test]
+fn native_llvm_bswap_v2i16_lowers() {
+    assert_native_bswap_vector_i16_lowers(2);
+}
+
+#[test]
+fn native_llvm_bswap_v4i16_lowers() {
+    assert_native_bswap_vector_i16_lowers(4);
+}
