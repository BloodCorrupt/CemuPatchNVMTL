Subject: [PATCH] Translator: lower llvm.bswap on i32 vectors

---
 .../translator/src/native/tests/intrinsics.rs | 58 +++++++++++++++++++
 .../src/passes/air_calls/integer_simd.rs      | 16 +++++
 .../src/passes/air_calls/reduce_bitops.rs     | 54 +++++++++++++++++
 3 files changed, 128 insertions(+)

diff --git a/translator/translator/src/native/tests/intrinsics.rs b/translator/translator/src/native/tests/intrinsics.rs
index cafee33c..e3a45f02 100644
--- a/translator/translator/src/native/tests/intrinsics.rs
+++ b/translator/translator/src/native/tests/intrinsics.rs
@@ -1285,6 +1285,64 @@ declare i32 @llvm.bswap.i32(i32)
     }
 }
 
+fn assert_native_bswap_vector_lowers(lanes: u32) {
+    let ll = format!(
+        r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @main(<{lanes} x i32> %x) {{
+entry:
+  %swapped = tail call <{lanes} x i32> @llvm.bswap.v{lanes}i32(<{lanes} x i32> %x)
+  ret void
+}}
+
+declare <{lanes} x i32> @llvm.bswap.v{lanes}i32(<{lanes} x i32>)
+"#
+    );
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_native_bswap_v{lanes}_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let module =
+        load_bytes(emit_vulkan_spirv(&ll).expect("native emit")).expect("load native spv");
+    let out = passes::transform(module, Stage::Kernel, None, None, None, Some("main"))
+        .expect("interface transform")
+        .assemble()
+        .iter()
+        .flat_map(|w| w.to_le_bytes())
+        .collect::<Vec<_>>();
+    let asm = disassemble(&out).expect("disassemble transformed");
+    assert!(asm.contains("OpShiftLeftLogical"), "{asm}");
+    assert!(asm.contains("OpShiftRightLogical"), "{asm}");
+    assert!(asm.contains("OpBitwiseAnd"), "{asm}");
+    assert!(asm.contains("OpBitwiseOr"), "{asm}");
+    // the byte masks and shift counts are splatted across every lane
+    assert!(asm.contains("OpConstantComposite"), "{asm}");
+    assert!(!asm.contains("OpFunctionCall"), "{asm}");
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&out, &tmp).expect("spirv-val");
+    }
+}
+
+#[test]
+fn native_llvm_bswap_v2i32_lowers() {
+    assert_native_bswap_vector_lowers(2);
+}
+
+#[test]
+fn native_llvm_bswap_v3i32_lowers() {
+    assert_native_bswap_vector_lowers(3);
+}
+
+#[test]
+fn native_llvm_bswap_v4i32_lowers() {
+    assert_native_bswap_vector_lowers(4);
+}
+
 #[test]
 fn native_llvm_abs_i32_lowers() {
     let ll = r#"
