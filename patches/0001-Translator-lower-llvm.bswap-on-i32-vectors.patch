+
+/// `llvm.bswap.v<N>i32`: the same lane-wise byte swap as [`byte_swap_i32`], with each mask and shift count
+/// splatted across the `lanes` lanes of the vector type `rty` (element type `elem`, a 32-bit integer).
+pub(in crate::passes) fn byte_swap_i32_vector(
+    ctx: &mut Ctx,
+    res: Word,
+    rty: Word,
+    elem: Word,
+    lanes: u32,
+    value: Word,
+) -> Vec<Instruction> {
+    let mut splat = |v: i64| {
+        let scalar = ctx.const_int_of(elem, v);
+        ctx.const_composite(rty, vec![scalar; lanes as usize])
+    };
+    let mask_byte0 = splat(0x0000_00ff);
+    let mask_byte1 = splat(0x0000_ff00);
+    let mask_byte2 = splat(0x00ff_0000);
+    let mask_byte3 = splat(0xff00_0000);
+    let shift8 = splat(8);
+    let shift24 = splat(24);
+    byte_swap_i32_with(
+        ctx,
+        res,
+        rty,
+        value,
+        [mask_byte0, mask_byte1, mask_byte2, mask_byte3],
+        shift8,
+        shift24,
+    )
+}
+
+/// The instructions of a 32-bit byte swap. `masks`, `shift8` and `shift24` are constants of type `rty` (scalar, or
+/// splatted vectors for a vector `rty`).
+fn byte_swap_i32_with(
+    ctx: &mut Ctx,
+    res: Word,
+    rty: Word,
+    value: Word,
+    masks: [Word; 4],
+    shift8: Word,
+    shift24: Word,
+) -> Vec<Instruction> {
+    let [mask_byte0, mask_byte1, mask_byte2, mask_byte3] = masks;
 
     let b0 = ctx.module.fresh_id();
     let b1 = ctx.module.fresh_id();
