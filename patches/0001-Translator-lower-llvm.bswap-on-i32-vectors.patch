diff --git a/translator/translator/src/passes/air_calls/reduce_bitops.rs b/translator/translator/src/passes/air_calls/reduce_bitops.rs
index 07dcb35e..16aac36f 100644
--- a/translator/translator/src/passes/air_calls/reduce_bitops.rs
